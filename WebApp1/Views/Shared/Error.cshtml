@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="error-page">
    <h1>Something went wrong</h1>
    <p>The request could not be completed. Try again, or head back to the console.</p>

    @if (Model.ShowRequestId)
    {
        <p>
            Reference: <code>@Model.RequestId</code>
        </p>
    }

    <div class="btn-row">
        <a class="btn btn--primary" asp-controller="Home" asp-action="Index">Back to console</a>
    </div>
</div>
