@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}

<div class="auth">
    <div class="auth__card">
        <h1 class="auth__title">Sign in</h1>
        <p class="auth__sub">Weather Seeker readings are available to registered accounts.</p>

        @if (!string.IsNullOrEmpty(ViewBag.Message as string))
        {
            <div class="summary-errors" role="alert">@ViewBag.Message</div>
        }

        <form class="auth__form" asp-controller="Login" asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="summary-errors"></div>

            <div class="field">
                <label class="field__label" asp-for="Username">Username</label>
                <input class="field__control" asp-for="Username" autocomplete="username"
                       autocapitalize="none" spellcheck="false" required />
                <span class="field__error" asp-validation-for="Username"></span>
            </div>

            <div class="field">
                <label class="field__label" asp-for="Password">Password</label>
                <input class="field__control" asp-for="Password" autocomplete="current-password" required />
                <span class="field__error" asp-validation-for="Password"></span>
            </div>

            <button class="btn btn--primary btn--block" type="submit">Log in</button>
        </form>

        <div class="auth__foot">
            <span>No account yet?</span>
            <a asp-controller="Home" asp-action="RegisterClient">Create a client account</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
