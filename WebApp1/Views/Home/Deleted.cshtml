@{
    ViewData["Title"] = "Account deleted";
}

<div class="auth">
    <div class="auth__card">
        <h1 class="auth__title">Account deleted</h1>
        <p class="auth__sub">
            The account and everything stored with it are gone. Nothing was kept.
        </p>

        <div class="auth__foot">
            <span>Want to start over?</span>
            <a asp-controller="Register" asp-action="Register">Create an account</a>
        </div>
    </div>
</div>
