@model Users
@{
    ViewData["Title"] = "Directory";
}

<div class="page-head">
    <h1>Directory</h1>
    <p>Add a name to the user table</p>
</div>

<div class="auth">
    <div class="auth__card">
        <p class="auth__sub">
            This form writes a single row to the <code>Users</code> table. It does not create a
            login — client and admin accounts are the only way to sign in.
        </p>

        @if (!string.IsNullOrEmpty(ViewBag.Message as string))
        {
            <div class="summary-errors" role="alert">@ViewBag.Message</div>
        }

        <form class="auth__form" asp-controller="Register" asp-action="RegisterUser" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="summary-errors"></div>

            <div class="field">
                <label class="field__label" asp-for="name">Name</label>
                <input class="field__control" asp-for="name" autocomplete="off" maxlength="100" required />
                <span class="field__error" asp-validation-for="name"></span>
            </div>

            <button class="btn btn--primary btn--block" type="submit">Add name</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
