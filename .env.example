POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=weatherseeker
POSTGRES_USER=weatherseeker
POSTGRES_PASSWORD=change-this-password
POSTGRES_SSL_MODE=Disable
ASPNETCORE_ENVIRONMENT=Production

# OpenWeatherMap API key from https://openweathermap.org/api
# Read only by the server; it is never sent to a browser.
OPENWEATHERMAP__APIKEY=

# Cloudflare Tunnel token (only used by the `cloudflare` compose profile)
CF_TUNNEL_TOKEN=

# First admin account. Applied at startup only when no admin with this
# username exists, so it is safe to leave in place on later restarts.
# Use a passphrase of 12+ characters, then delete these two lines.
BOOTSTRAP_ADMIN__USERNAME=
BOOTSTRAP_ADMIN__PASSWORD=

# Comma-separated proxy addresses or CIDR ranges that may set
# X-Forwarded-For / X-Forwarded-Proto. Leave empty when the app is reached
# directly. Behind Cloudflare Tunnel the connection arrives from the
# cloudflared container, e.g. TRUSTED_PROXIES=172.16.0.0/12
TRUSTED_PROXIES=
